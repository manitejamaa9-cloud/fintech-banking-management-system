# Copy this file to server/.env and edit the values.
# The server always reads server/.env, no matter which folder you start it from.

# --- Application ---
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES=8h
DEMO_OTP=123456

# Seed demo data automatically only when the database is completely empty.
AUTO_SEED=true


# Extra allowed browser origin for CORS (the Vite dev server is allowed by default).
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL (required) ---
# The app does not fall back to an in-memory database.
PGHOST=localhost
PGPORT=5432
PGDATABASE=fintech_banking
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Optional: use a single connection string instead of the PG* values above.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fintech_banking
